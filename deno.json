{
  "name": "@dune/testing",
  "version": "3.0.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./harness": "./src/harness.ts",
    "./app-harness": "./src/app-harness.ts",
    "./stub-admin": "./src/stub-admin.ts",
    "./conformance": "./src/conformance.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@dune/core": "jsr:@dune/core@^0.37",
    "@dune/core/storage": "jsr:@dune/core@^0.37/storage",
    "@dune/core/api": "jsr:@dune/core@^0.37/api",
    "@dune/core/bootstrap": "jsr:@dune/core@^0.37/bootstrap",
    "@dune/core/engine": "jsr:@dune/core@^0.37/engine",
    "@dune/core/search": "jsr:@dune/core@^0.37/search",
    "@dune/core/fresh-app": "jsr:@dune/core@^0.37/fresh-app",
    "@dune/plugin-api": "jsr:@dune/plugin-api@^1.2.0"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@dune/core", "jsr:@dune/plugin-api"]
  },
  "tasks": {
    "test": "deno test --allow-env --unstable-kv tests/",
    "check": "deno fmt --check && deno lint && deno check src/**/*.ts tests/**/*.ts"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
