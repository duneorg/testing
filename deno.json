{
  "name": "@dune/testing",
  "version": "1.0.3",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./harness": "./src/harness.ts",
    "./app-harness": "./src/app-harness.ts",
    "./stub-admin": "./src/stub-admin.ts",
    "./conformance": "./src/conformance.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@dune/core": "jsr:@dune/core@^0.36",
    "@dune/core/storage": "jsr:@dune/core@^0.36/storage",
    "@dune/core/api": "jsr:@dune/core@^0.36/api",
    "@dune/core/bootstrap": "jsr:@dune/core@^0.36/bootstrap",
    "@dune/core/engine": "jsr:@dune/core@^0.36/engine",
    "@dune/core/hooks": "jsr:@dune/core@^0.36/hooks",
    "@dune/core/search": "jsr:@dune/core@^0.36/search",
    "@dune/core/config": "jsr:@dune/core@^0.36/config",
    "@dune/core/fresh-app": "jsr:@dune/core@^0.36/fresh-app",
    "@dune/core/workflow": "jsr:@dune/core@^0.36/workflow",
    "@dune/core/plugin-api": "jsr:@dune/core@^0.36/plugin-api"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@dune/core"]
  },
  "tasks": {
    "test": "deno test --allow-env --unstable-kv tests/",
    "check": "deno fmt --check && deno lint && deno check src/**/*.ts tests/**/*.ts"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
